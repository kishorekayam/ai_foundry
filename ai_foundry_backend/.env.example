# ---------------- API ----------------
CORS_ORIGINS=http://localhost:5173
# Common HTTP Basic credentials for EVERY API (React, Boomi -> FastAPI, FastAPI -> Boomi). Required: the API refuses calls without them.
API_USERNAME=
API_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8000

# ---------------- Common registry database (MySQL): approved targets + encrypted creds + Boomi audit ----------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=atom_registry_app
MYSQL_PASSWORD=
MYSQL_DATABASE=atom_registry
# Only for `registry_admin.py init` (creates the database): e.g. mysql+pymysql://root:<pw>@localhost:3306
MYSQL_ADMIN_URL=
# Generated by: python scripts/registry_admin.py genkey
REGISTRY_ENCRYPTION_KEY=

# ---------------- Boomi (runtime shared web server hosting the Process A / B listeners) ----------------
BOOMI_ENABLED=false
SERVER_BASE_URL=
SERVER_AUTH_TYPE=basic
SERVER_USERNAME=
SERVER_TOKEN=
SERVER_BEARER_TOKEN=
SERVER_VERIFY_SSL=true

# ---------------- Hosted LLM (leave key empty to use rule-based planners) ----------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
